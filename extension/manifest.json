{
  "manifest_version": 3,
  "name": "Recall Memory Lane - Smart Web Clipper",
  "version": "1.0.0",
  "description": "Intelligent offline web clipper powered by Defuddle with automatic extraction, configurable dwell time, website categorization, and semantic local indexing.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Recall Web Clipper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/defuddle.bundle.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
